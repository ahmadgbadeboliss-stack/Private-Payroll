{
  "name": "private-payroll",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Confidential payroll & splits on Midnight — pay many people from one pool without exposing individual amounts on-chain.",
  "scripts": {
    "compile": "bash scripts/compile.sh",
    "copy:assets": "node scripts/copy-contract-assets.mjs",
    "dev": "npm run copy:assets && vite",
    "build": "npm run copy:assets && tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "proof-server": "docker compose up -d",
    "proof-server:stop": "docker compose down",
    "deploy:preview": "tsx scripts/deploy-preview.ts",
    "print-address": "tsx scripts/print-address.ts",
    "generate-wallet": "tsx scripts/generate-wallet.ts",
    "wallet:status": "tsx scripts/wallet-status.ts",
    "dust:setup": "tsx scripts/dust-setup.ts",
    "verify-contract": "tsx scripts/verify-contract.ts"
  },
  "dependencies": {
    "@midnight-ntwrk/compact-runtime": "0.16.0",
    "@midnight-ntwrk/dapp-connector-api": "4.0.1",
    "@midnight-ntwrk/midnight-js-contracts": "4.1.1",
    "@midnight-ntwrk/midnight-js-fetch-zk-config-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-http-client-proof-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-indexer-public-data-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-level-private-state-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-network-id": "4.1.1",
    "@midnight-ntwrk/midnight-js-node-zk-config-provider": "^4.1.1",
    "@midnight-ntwrk/midnight-js-protocol": "4.1.1",
    "@midnight-ntwrk/midnight-js-types": "4.1.1",
    "@midnight-ntwrk/midnight-js-utils": "4.1.1",
    "@midnight-ntwrk/wallet-sdk": "1.2.0",
    "@scure/bip39": "^2.2.0",
    "buffer": "^6.0.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "rxjs": "^7.8.2",
    "semver": "^7.7.2",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/semver": "^7.7.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.0",
    "vite-plugin-top-level-await": "^1.6.0",
    "vite-plugin-wasm": "^3.5.0",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "overrides": {
    "@midnight-ntwrk/onchain-runtime-v3": "3.0.0"
  },
  "keywords": [
    "midnight",
    "zero-knowledge",
    "privacy",
    "payroll",
    "compact"
  ],
  "license": "Apache-2.0"
}
